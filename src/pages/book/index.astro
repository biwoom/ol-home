---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

const books = (
  await getCollection('book', e => e.data.published === true)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  title="OL BOOK — 불교 콘텐츠 라이브러리"
  description="완결된 OL 불교 콘텐츠를 브라우저에서 읽거나 내려받을 수 있습니다."
>
  <main>
    <!-- Hero -->
    <section class="ol-hero">
      <div class="ol-container">
        <span class="ol-kicker">LIBRARY · 콘텐츠 in ATLAS</span>
        <h1 class="ol-kr">
          <em>읽고, 고치고, 나누는</em><br>
          불교 콘텐츠 책장.
        </h1>
        <p class="ol-lead ol-kr">
          OL BOOK은 ATLAS 위에서 동작하는 불교콘텐츠들입니다. 한 권 한 권이 단일 HTML이고, 누군가의 책상 위에서 그대로 열립니다. 원본을 가져가 자기 방식으로 다시 만들어도 좋습니다.
        </p>
      </div>
    </section>
    
    <hr style="margin:80px 0 40px; width: 80%; margin:0 auto;" /> 

    <section class="ol-section">
      <div class="ol-container">
        <div style="margin-bottom: 48px;">
          <span class="ol-kicker">BOOK · 출판된 지혜</span>
          <h1 style="font-size: 32px; margin-top: 10px; margin-bottom: 20px;" class="ol-kr">
            OL BOOK 라이브러리
          </h1>
           <!-- Filter row -->
          <div class="ol-row" style="flex-wrap: wrap; gap: 16px;">
          <div class="ol-chips">
            <button class="ol-chip active">전체 <span class="count">12</span></button>
            <button class="ol-chip">경전 <span class="count">4</span></button>
            <button class="ol-chip">강의 <span class="count">3</span></button>
            <button class="ol-chip">인물 · 행적 <span class="count">3</span></button>
            <button class="ol-chip">시화 <span class="count">2</span></button>
          </div>
          <div class="ol-spacer"></div>
          <div class="ol-tabs">
            <button class="active">표지 그리드</button>
            <button>목록</button>
          </div>
        </div>

          <!-- <p style="color:var(--ol-muted);margin-top:12px;max-width:52ch;line-height:1.7;" class="ol-kr">
            완결된 불교 콘텐츠를 브라우저에서 읽거나 단일 HTML 파일로 내려받을 수 있습니다.
            모든 파일은 설치 없이 브라우저 하나로 열립니다.
          </p> -->
          <!-- <div style="margin-top:16px;">
            <a href={url('/works')} class="ol-btn ol-btn-outline ol-btn-sm">
              제작 중인 원고 보기 (WORKS) →
            </a>
          </div> -->
        </div>

        {books.length > 0 ? (
          <div class="ol-grid-2">
            {books.map(book => (
              <div class="ol-card" style="display:flex;flex-direction:column;gap:20px;">
                <div>
                  <span class="ol-mono-label" style="margin-bottom:8px;display:block;">
                    {new Date(book.data.publishedAt).getFullYear()} · {book.data.version}
                    {book.data.level && ` · 난이도 ${book.data.level}/5`}
                  </span>
                  <h2 style="font-size:22px;margin:0 0 8px;" class="ol-kr">
                    {book.data.title}
                  </h2>
                  {book.data.subtitle && (
                    <p style="font-size:14px;color:var(--ol-muted);margin:0 0 8px;" class="ol-kr">
                      {book.data.subtitle}
                    </p>
                  )}
                  {book.data.description && (
                    <p style="font-size:14px;color:var(--ol-muted);line-height:1.6;" class="ol-kr">
                      {book.data.description}
                    </p>
                  )}
                </div>

                {book.data.tags.length > 0 && (
                  <div style="display:flex;gap:6px;flex-wrap:wrap;">
                    {book.data.tags.map(tag => (
                      <span class="ol-badge">{tag}</span>
                    ))}
                  </div>
                )}

                <div style="display:flex;gap:10px;margin-top:auto;">
                  <a
                    href={url(`/books/${book.data.htmlPath}/`)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ol-btn ol-btn-primary ol-btn-sm"
                    style="flex:1;justify-content:center;"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"/>
                      <line x1="2" y1="12" x2="22" y2="12"/>
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                    </svg>
                    웹에서 읽기
                  </a>

                  <a
                    href={url(`/books/${book.data.htmlPath}/index.html`)}
                    download={`${book.data.title}-${book.data.version}.html`}
                    class="ol-btn ol-btn-outline ol-btn-sm"
                    style="flex:1;justify-content:center;"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 3v13m0 0 4-4m-4 4-4-4M4 21h16"/>
                    </svg>
                    HTML 내려받기
                  </a>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div style="text-align:center;padding:80px 0;color:var(--ol-muted);">
            <p class="ol-kr" style="font-size:15px;">준비 중입니다.</p>
            <p class="ol-kr" style="font-size:13px;margin-top:8px;">
              <a href={url('/works')} style="color:inherit;">WORKS</a>에서 제작 중인 원고를 먼저 만나보세요.
            </p>
          </div>
        )}

      </div>
    </section>


    <!-- WHY callout -->
    <hr style="margin:80px 0 40px; width: 80%; margin:0 auto;" /> 
    <section class="ol-section">
      <div class="ol-container">
        <div class="ol-card" style="background: var(--ol-surface-2); border-color: var(--ol-border); padding: 36px;">
          <div class="ol-section-grid-2">
            <div>
              <span class="ol-kicker">WHY · ATLAS + BOOK</span>
              <h3 style="font-size: 26px; margin-top: 12px; letter-spacing: -0.02em; line-height: 1.3;" class="ol-kr">"콘텐츠를 도구와 함께 배포한다는 것"</h3>
            </div>
            <p style="color: var(--ol-ink-2); line-height: 1.75; font-size: 14.5px;" class="ol-kr">
              기존 디지털 콘텐츠는 만든 사람의 플랫폼에 갇혀 있습니다.
              OL은 도구(ATLAS)와 콘텐츠(BOOK)를 같은 파일로 묶어 배포합니다 — 책 한 권을 받는 것이, 그 책을 만든 작업실을 받는 일과 같아지도록.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
