---
import { getCollection, render } from 'astro:content';
import BookLayout from '../../layouts/BookLayout.astro';

export async function getStaticPaths() {
  const books = await getCollection('works', e => e.data.published);
  return books.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BookLayout title={`${entry.data.title} — OL BOOK`}>
  <article>
    <header style="margin-bottom: 48px; padding-bottom: 24px; border-bottom: 1px solid var(--ol-border);">
      {entry.data.series && (
        <span class="ol-mono-label">{entry.data.series}</span>
      )}
      <h1 style="font-size: 42px; margin-top: 8px; letter-spacing: -0.03em;" class="ol-kr">
        {entry.data.title}
      </h1>
    </header>
    <div class="ol-prose">
      <Content />
    </div>
  </article>
</BookLayout>
