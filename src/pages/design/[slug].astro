---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const items = await getCollection('design', e => e.data.published);
  return items.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} — OL DESIGN`}>
  <main>
    <section class="ol-section">
      <div class="ol-container" style="max-width: 800px;">
        <header style="margin-bottom: 48px; padding-bottom: 24px; border-bottom: 1px solid var(--ol-border);">
          <span class="ol-kicker">{entry.data.category ?? entry.data.type ?? 'DESIGN'}</span>
          <h1 style="font-size: 36px; margin-top: 8px; letter-spacing: -0.03em;" class="ol-kr">
            {entry.data.title}
          </h1>
        </header>
        <div class="ol-prose">
          <Content />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
