---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
import { typeLabel, typeOrder } from '../../lib/design';

const allItems = await getCollection('design', e => e.data.published);
allItems.sort((a, b) => a.data.title.localeCompare(b.data.title, 'ko'));

const PAGE_SIZE = 12;

const typeCounts = allItems.reduce((acc, item) => {
  const t = item.data.type ?? 'other';
  acc[t] = (acc[t] ?? 0) + 1;
  return acc;
}, {} as Record<string, number>);

const allTags = [...new Set(allItems.flatMap(i => i.data.tags))].sort((a, b) => a.localeCompare(b, 'ko'));
---

<BaseLayout
  title="OL DESIGN — 불교 콘텐츠 스타일 레퍼런스"
  description="불교 콘텐츠를 위한 스타일 레퍼런스 — 인물·복장·건물·지역환경·원문 데이터."
>
  <main>
    <!-- Hero -->
    <section class="ol-hero" style="padding-bottom: 32px;">
      <div class="ol-container">
        <span class="ol-kicker">ARCHIVE · 스타일 레퍼런스</span>
        <h1 class="ol-kr">
          불교 콘텐츠 제작을 위한<br>
          <em>스타일 레퍼런스</em> 아카이브.
        </h1>
        <p class="ol-lead ol-kr">
          승복 한 벌의 색, 한 절의 처마 비례, 고대 인도 도시의 평면 — 불교 콘텐츠를 만들 때 매번 처음부터 조사해야 했던 자료들을 모읍니다.
        </p>
      </div>
    </section>

    <!-- Layout: sidebar + grid -->
    <section class="ol-section-tight">
      <div class="ol-container">
        <div class="ol-design-layout">

          <!-- ── Sidebar ── -->
          <aside class="ol-design-sidebar">
            <div class="ol-design-sidebar-inner">

              <!-- Category -->
              <div class="ol-design-filter-group">
                <div class="ol-design-filter-label">CATEGORY</div>
                <ul class="ol-design-cat-list">
                  <li>
                    <button
                      class="ol-design-cat-btn active"
                      data-filter-type="all"
                      data-count={allItems.length}
                    >
                      <span class="cat-name ol-kr">전체</span>
                      <span class="cat-count">{allItems.length}</span>
                    </button>
                  </li>
                  {typeOrder.map(type => {
                    const count = typeCounts[type] ?? 0;
                    return (
                      <li>
                        <button
                          class="ol-design-cat-btn"
                          data-filter-type={type}
                          data-count={count}
                          disabled={count === 0}
                        >
                          <span class="cat-name ol-kr">{typeLabel[type]}</span>
                          <span class="cat-count">{count}</span>
                        </button>
                      </li>
                    );
                  })}
                </ul>
              </div>

              <!-- Tags -->
              {allTags.length > 0 && (
                <div class="ol-design-filter-group">
                  <div class="ol-design-filter-label">TAGS</div>
                  <div class="ol-design-tag-cloud">
                    {allTags.map(tag => (
                      <button class="ol-design-tag-btn" data-filter-tag={tag}>
                        {tag}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <!-- CC0 note -->
              <div class="ol-design-sidebar-note">
                <span class="ol-mono-label" style="font-size: 20px; letter-spacing: -0.02em;">CC0</span>
                <p class="ol-kr">출처 표기 없이 자유롭게 사용할 수 있습니다.</p>
              </div>

            </div>
          </aside>

          <!-- ── Main ── -->
          <div class="ol-design-main">

            <!-- Toolbar -->
            <div class="ol-design-toolbar">
              <div class="ol-design-toolbar-count">
                <span id="design-visible-count">{allItems.length}</span>개 자료
              </div>
              <div class="ol-design-active-filters" id="design-active-filters"></div>
            </div>

            <!-- Empty state -->
            {allItems.length === 0 && (
              <div style="padding: 80px 0; text-align: center; color: var(--ol-muted); font-family: var(--ol-font-mono); font-size: 13px;">
                아직 등록된 자료가 없습니다.
              </div>
            )}

            <!-- Grid -->
            <div class="ol-design-grid" id="design-grid">
              {allItems.map((item, i) => (
                <a
                  class="ol-design-card"
                  href={url(`/design/${item.id}`)}
                  data-type={item.data.type ?? 'other'}
                  data-tags={item.data.tags.join(',')}
                  data-index={i}
                  style={i >= PAGE_SIZE ? 'display:none;' : ''}
                >
                  <div class="ol-design-card-img">
                    {item.data.imagePath ? (
                      <img
                        src={url(`/design/${item.data.imagePath}`)}
                        alt={item.data.imageAlt ?? item.data.title}
                        loading={i < 6 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    ) : (
                      <div class="ol-ph" style="width:100%;height:100%;">
                        {(item.data.type ?? 'DESIGN').toUpperCase()}
                      </div>
                    )}
                  </div>
                  <div class="ol-design-card-meta">
                    <div class="ol-design-card-type">
                      {item.data.type ? typeLabel[item.data.type] : 'DESIGN'}
                      {item.data.series && <span class="ol-design-card-series"> · {item.data.series}</span>}
                    </div>
                    <h3 class="ol-design-card-title ol-kr">{item.data.title}</h3>
                    {item.data.era && (
                      <div class="ol-design-card-era">{item.data.era}</div>
                    )}
                  </div>
                </a>
              ))}
            </div>

            <!-- No results (filtered) -->
            <div id="design-no-results" style="display:none; padding: 60px 0; text-align: center; color: var(--ol-muted); font-size: 14px;" class="ol-kr">
              선택한 필터에 해당하는 자료가 없습니다.
            </div>

            <!-- Load more -->
            {allItems.length > PAGE_SIZE && (
              <div class="ol-design-loadmore" id="design-loadmore-wrap">
                <button id="design-loadmore-btn" class="ol-btn ol-btn-outline">
                  더 보기
                  <span id="design-loadmore-remaining">
                    ({allItems.length - PAGE_SIZE})
                  </span>
                </button>
              </div>
            )}

          </div>
        </div>
      </div>
    </section>
  </main>
  <script type="application/json" id="design-type-labels" set:html={JSON.stringify(typeLabel)} />
</BaseLayout>

<script>
  // ─── state ───────────────────────────────────────────────
  const PAGE_SIZE = 12;
  let activeType = 'all';
  let activeTag: string | null = null;
  let visibleCount = PAGE_SIZE;

  // ─── elements ────────────────────────────────────────────
  const grid = document.getElementById('design-grid')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.ol-design-card'));
  const countEl = document.getElementById('design-visible-count')!;
  const noResults = document.getElementById('design-no-results')!;
  const activeFiltersEl = document.getElementById('design-active-filters')!;
  const loadmoreWrap = document.getElementById('design-loadmore-wrap');
  const loadmoreBtn = document.getElementById('design-loadmore-btn');
  const loadmoreRemaining = document.getElementById('design-loadmore-remaining');

  // ─── filter logic ─────────────────────────────────────────
  function matchCard(card: HTMLElement): boolean {
    const type = card.dataset.type ?? 'other';
    const tags = (card.dataset.tags ?? '').split(',').filter(Boolean);
    if (activeType !== 'all' && type !== activeType) return false;
    if (activeTag && !tags.includes(activeTag)) return false;
    return true;
  }

  function applyFilters() {
    const matched = cards.filter(matchCard);
    const unmatched = cards.filter(c => !matchCard(c));

    // Reset visibleCount per filter change
    visibleCount = PAGE_SIZE;

    matched.forEach((c, i) => {
      c.style.display = i < visibleCount ? '' : 'none';
    });
    unmatched.forEach(c => { c.style.display = 'none'; });

    countEl.textContent = String(matched.length);
    noResults.style.display = matched.length === 0 ? '' : 'none';

    // Load more button
    if (loadmoreWrap && loadmoreRemaining) {
      const remaining = matched.length - visibleCount;
      if (remaining > 0) {
        loadmoreWrap.style.display = '';
        loadmoreRemaining.textContent = `(${remaining})`;
      } else {
        loadmoreWrap.style.display = 'none';
      }
    }

    // Active filter pills
    updateFilterPills();
  }

  function updateFilterPills() {
    activeFiltersEl.innerHTML = '';
    if (activeType !== 'all') {
      const pill = makePill(typeLabels[activeType] ?? activeType, () => {
        activeType = 'all';
        document.querySelectorAll<HTMLElement>('.ol-design-cat-btn').forEach(b => {
          b.classList.toggle('active', b.dataset.filterType === 'all');
        });
        applyFilters();
      });
      activeFiltersEl.appendChild(pill);
    }
    if (activeTag) {
      const pill = makePill(`#${activeTag}`, () => {
        activeTag = null;
        document.querySelectorAll<HTMLElement>('.ol-design-tag-btn').forEach(b => b.classList.remove('active'));
        applyFilters();
      });
      activeFiltersEl.appendChild(pill);
    }
  }

  function makePill(label: string, onClose: () => void) {
    const span = document.createElement('span');
    span.className = 'ol-design-filter-pill';
    span.innerHTML = `${label} <button aria-label="필터 해제">×</button>`;
    span.querySelector('button')!.addEventListener('click', onClose);
    return span;
  }

  const typeLabels: Record<string, string> = JSON.parse(document.getElementById('design-type-labels')!.textContent!);

  // ─── category buttons ─────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.ol-design-cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      activeType = btn.dataset.filterType ?? 'all';
      document.querySelectorAll<HTMLElement>('.ol-design-cat-btn').forEach(b => {
        b.classList.toggle('active', b === btn);
      });
      applyFilters();
    });
  });

  // ─── tag buttons ──────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.ol-design-tag-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.filterTag ?? '';
      if (activeTag === tag) {
        activeTag = null;
        btn.classList.remove('active');
      } else {
        activeTag = tag;
        document.querySelectorAll<HTMLElement>('.ol-design-tag-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      }
      applyFilters();
    });
  });

  // ─── load more ────────────────────────────────────────────
  loadmoreBtn?.addEventListener('click', () => {
    const matched = cards.filter(matchCard);
    visibleCount += PAGE_SIZE;
    matched.forEach((c, i) => { c.style.display = i < visibleCount ? '' : 'none'; });
    const remaining = matched.length - visibleCount;
    if (remaining > 0 && loadmoreRemaining) {
      loadmoreRemaining.textContent = `(${remaining})`;
    } else if (loadmoreWrap) {
      loadmoreWrap.style.display = 'none';
    }
  });
</script>
