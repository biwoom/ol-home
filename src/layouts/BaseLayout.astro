---
import '../styles/global.css';
import OLHeader from '../components/layout/OLHeader.astro';
import OLFooter from '../components/layout/OLFooter.astro';
import OLSearchModal from '../components/layout/OLSearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = 'OL — Weaving the Wisdom',
  description = 'OL(올)은 한 올, 한 올 지혜를 엮어가는 불교 콘텐츠 프로젝트입니다.',
  lang = 'ko',
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/ol-home/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/ol-home/favicon-16.png" />
  <link rel="icon" href="/ol-home/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/ol-home/apple-touch-icon.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+KR:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <!-- Dark mode init (prevents FOUC) -->
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('ol-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = saved || (prefersDark ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    })();
  </script>
  <!-- Works sidebar: 기본 닫힌 상태 -->
  <script is:inline>
    document.documentElement.setAttribute('data-works-sidebar', 'closed');
  </script>
</head>
<body class="ol-kr">
  <div class="ol-app">
    <OLHeader />
    <OLSearchModal />
    <div data-pagefind-body>
      <slot />
    </div>
    <OLFooter />
  </div>
</body>
</html>
