---
import { getCollection } from 'astro:content';
import fs from 'node:fs';

const books = await getCollection('book', ({ data }) => data.published);
const designs = await getCollection('design', ({ data }) => data.published);
const blogs = await getCollection('blog', ({ data }) => data.published);

const atlasFiles = fs.readdirSync('public/atlas/latest').filter(f => f.endsWith('.html'));
const atlasVersion = atlasFiles[0]?.match(/v(\d+\.\d+\.\d+)/)?.[1] ?? '0.0.0';
---
<section class="ol-section-tight">
  <div class="ol-container">
    <div class="ol-stats">
      <div class="ol-stat">
        <div class="n"><em>{books.length}</em></div>
        <div class="l">콘텐츠 BOOK</div>
      </div>
      <div class="ol-stat">
        <div class="n"><em>{designs.length}</em></div>
        <div class="l">DESIGN 자료</div>
      </div>
      <div class="ol-stat">
        <div class="n"><em>{blogs.length}</em></div>
        <div class="l">BLOG 기록</div>
      </div>
      <div class="ol-stat">
        <div class="n"><em>v{atlasVersion}</em></div>
        <div class="l">ATLAS 빌드</div>
      </div>
    </div>
  </div>
</section>
